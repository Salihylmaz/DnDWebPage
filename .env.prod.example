# Production environment variables
# Copy this file to .env on your VPS and fill in real values.
# NEVER commit .env to git.

POSTGRES_USER=dnd
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=dnd_session_manager

JWT_SECRET=change-this-to-a-very-long-random-string

APP_DOMAIN=dnd.example.com
CLIENT_ORIGIN=https://dnd.example.com
APP_BASE_URL=https://dnd.example.com

# Google Identity Services web client ID (the client ID is public)
GOOGLE_CLIENT_ID=

# SMTP is required for email/password registration and verification links.
# Use port 465 for implicit TLS or 587 for STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Docker image tags (set by CI/CD)
DOCKER_IMAGE_SERVER=ghcr.io/salihylmaz/dnd-server
DOCKER_IMAGE_CLIENT=ghcr.io/salihylmaz/dnd-client
IMAGE_TAG=latest
