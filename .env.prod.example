# Production environment variables
# Copy this file to .env on your VPS and fill in real values.
# NEVER commit .env to git.

POSTGRES_USER=dnd
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=dnd_session_manager

JWT_SECRET=change-this-to-a-very-long-random-string

CLIENT_ORIGIN=https://yourdomain.com

# Docker image tags (set by CI/CD)
DOCKER_IMAGE_SERVER=ghcr.io/YOUR_GITHUB_USERNAME/dnd-server
DOCKER_IMAGE_CLIENT=ghcr.io/YOUR_GITHUB_USERNAME/dnd-client
IMAGE_TAG=latest
